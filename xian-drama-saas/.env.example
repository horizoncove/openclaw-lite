# 应用端口（对外映射）
APP_PORT=3001

# PostgreSQL
POSTGRES_USER=xian_drama
POSTGRES_PASSWORD=xian_drama_pass
POSTGRES_DB=xian_drama
POSTGRES_PORT=5432

# 应用连接串（Docker Compose 会自动拼接，手动部署时填写）
DATABASE_URL=postgresql://xian_drama:xian_drama_pass@127.0.0.1:5432/xian_drama

# 存储后端：postgres | json（未设置 DATABASE_URL 时自动降级 json）
STORAGE=postgres

# 连接池大小
DB_POOL_MAX=10

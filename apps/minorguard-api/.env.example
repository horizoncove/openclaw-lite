PORT=5178
HOST=0.0.0.0

# optional cloud LLM (leave empty for local-rules only)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
CLOUD_LLM_ENABLED=true
LLM_TIMEOUT_MS=45000

# auth modes: demo_open | admin_token | strict
# App integration (recommended production):
#   AUTH_MODE=strict
#   MINORGUARD_API_TOKEN=...   # apps call analyze/chat
#   MINORGUARD_ADMIN_TOKEN=... # ops read ledger only
AUTH_MODE=demo_open
MINORGUARD_API_TOKEN=
# MINORGUARD_API_TOKENS=token1,token2
MINORGUARD_ADMIN_TOKEN=

# Browser direct calls (prefer BFF instead): comma origins or *
CORS_ORIGIN=

ALLOW_DEMO_SEED=true
DB_PATH=./data/minorguard.db
EVENT_RETENTION_DAYS=180

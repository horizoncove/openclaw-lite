PORT=5178
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Cloud LLM：auto | doubao | deepseek | openai_compatible | none
# auto 优先级：豆包/方舟 Key → DeepSeek Key → 通用 OpenAI 兼容
# ---------------------------------------------------------------------------
LLM_PROVIDER=auto
CLOUD_LLM_ENABLED=true
LLM_TIMEOUT_MS=45000
LLM_JSON_MODE=true

# --- 豆包 / 火山方舟（推荐）---
# 控制台：火山方舟 ModelArk → API Key + 推理接入点 Endpoint ID（ep-xxxx）
DOUBAO_API_KEY=
# 兼容别名：ARK_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# model 必须填方舟「推理接入点 ID」，不是控制台展示名
DOUBAO_MODEL=
# 兼容别名：DOUBAO_ENDPOINT= / ARK_ENDPOINT=

# --- DeepSeek（可选回退）---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- 通用 OpenAI 兼容（可选）---
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# auth modes: demo_open | admin_token | strict
# App integration (recommended production):
#   AUTH_MODE=strict
#   MINORGUARD_API_TOKEN=...   # apps call analyze/chat
#   MINORGUARD_ADMIN_TOKEN=... # ops read ledger only
AUTH_MODE=demo_open
MINORGUARD_API_TOKEN=
# MINORGUARD_API_TOKENS=token1,token2
MINORGUARD_ADMIN_TOKEN=

# Browser direct calls (prefer BFF instead): comma origins or *
CORS_ORIGIN=

ALLOW_DEMO_SEED=true
DB_PATH=./data/minorguard.db
EVENT_RETENTION_DAYS=180
